{
    "name": "recranet/twig-spreadsheet-bundle",
    "type": "symfony-bundle",
    "description": "This Symfony bundle integrates PhpSpreadsheet into Symfony using Twig.",
    "keywords": ["excel","phpexcel","spreadsheet","phpspreadsheet","twig","symfony"],
    "homepage": "https://github.com/recranet/TwigSpreadsheetBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Recranet",
            "email": "info@recranet.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "phpoffice/phpspreadsheet": "^1.23|^2.0|^3.3|^4.0|^5.0",
        "symfony/framework-bundle": "^7.4|^8.0",
        "symfony/routing": "^7.4|^8.0",
        "symfony/twig-bridge": "^7.4|^8.0",
        "symfony/twig-bundle": "^7.4|^8.0",
        "twig/twig": "^3.12"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^9",
        "rector/rector": "^2.6",
        "symfony/browser-kit": "^7.4|^8.0",
        "symfony/phpunit-bridge": "^7.4|^8.0",
        "symfony/yaml": "^7.4|^8.0"
    },
    "suggest": {
        "dompdf/dompdf": "Add support for PDF rendering using dompdf",
        "mpdf/mpdf": "Add support for PDF rendering using mPDF",
        "tecnickcom/tcpdf": "Add support for PDF rendering using TCPDF"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": { "Recranet\\TwigSpreadsheetBundle\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Recranet\\TwigSpreadsheetBundle\\Tests\\": "tests/" }
    }
}
